# Backend API URL (trailing slash required)
# For Android emulator use: http://10.0.2.2:8000/
# For local dev machine: http://localhost:8000/
# For production: https://himoinsa.cloudx.net.za:8001/
EXPO_PUBLIC_BACKEND_DOMAIN=http://localhost:8000/

# App domain (trailing slash required)
EXPO_PUBLIC_DOMAIN=http://localhost:3000/

# Google Maps API key (used by react-native-maps on Android via app.json config)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
